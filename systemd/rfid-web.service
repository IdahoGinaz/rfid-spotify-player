[Unit]
Description=RFID jukebox card manager (web UI)
After=network-online.target

[Service]
Type=simple
User=jukebox
EnvironmentFile=/etc/rfid-player.env
ExecStart=/home/jukebox/rfid-spotify-player/.venv/bin/rfid-player web
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
