[Unit]
Description=Spotify Soloist (Spotify Connect receiver)
After=pipewire-pulse.service network-online.target
Wants=pipewire-pulse.service

[Service]
EnvironmentFile=%h/.config/soloist.env
ExecStart=%h/.local/bin/soloist --device-name "RFID Jukebox" --api-key ${SOLOIST_API_KEY} --ws 127.0.0.1:9090
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
