# Copy to /etc/rfid-player.env (chmod 600) on the Pi
# Spotify Soloist API key from https://developer.spotify.com/dashboard/soloist (keep private)
SOLOIST_API_KEY=your_soloist_api_key
SOLOIST_WS=ws://127.0.0.1:9090
# Pause when the card is lifted and resume when it is put back (1), or keep playing (0)
PAUSE_ON_REMOVE=1
